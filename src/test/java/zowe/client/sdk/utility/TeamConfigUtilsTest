package zowe.client.sdk.utility;

import org.junit.jupiter.api.Test;

import java.util.List;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Class containing unit tests for TeamConfigUtils.
 *
 * @author Frank Giordano
 * @version 7.0
 */
public class TeamConfigUtilsTest {

    @Test
    void tstGetMaskedPropertiesNullAndEmptySuccess() {
        assertTrue(TeamConfigUtils.getMaskedProperties(null).isEmpty());
        assertTrue(TeamConfigUtils.getMaskedProperties(Map.of()).isEmpty());
    }

    @Test
    void tstGetMaskedPropertiesSensitiveKeySuccesss() {
        Map<String, String> props = Map.of(
                "host", "myhost.com",
                "port", "443",
                "password", "secretPwd",
                "myToken", "tok123",
                "user", "admin"
        );

        Map<String, String> masked = TeamConfigUtils.getMaskedProperties(props);
        assertEquals("myhost.com", masked.get("host"));
        assertEquals("443", masked.get("port"));
        assertEquals("*****", masked.get("password"));
        assertEquals("*****", masked.get("myToken"));
        assertEquals("admin", masked.get("user"));
    }

    @Test
    void tstGetMaskedPropertiesWithSecureListSuccess() {
        Map<String, String> props = Map.of(
                "host", "myhost.com",
                "customUser", "user1"
        );

        Map<String, String> masked = TeamConfigUtils.getMaskedProperties(props, List.of("customUser"));
        assertEquals("myhost.com", masked.get("host"));
        assertEquals("*****", masked.get("customUser"));
    }

    @Test
    void tstIsSensitiveKeySuccess() {
        assertTrue(TeamConfigUtils.isSensitiveKey("password", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("pwd", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("bearerToken", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("clientSecret", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("clientCertPass", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("apiKey", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("authToken", null));
        assertTrue(TeamConfigUtils.isSensitiveKey("userCreds", null));
        assertFalse(TeamConfigUtils.isSensitiveKey("host", null));
        assertFalse(TeamConfigUtils.isSensitiveKey("port", null));
        assertFalse(TeamConfigUtils.isSensitiveKey(null, null));
    }

}
